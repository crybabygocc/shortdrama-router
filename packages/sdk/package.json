{
  "name": "shortdrama-router",
  "version": "0.2.0",
  "description": "OpenAI/OpenRouter-style audio, image and video router for short-drama services",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "bin": {
    "shortdrama-router": "dist/bundle/cli.js"
  },
  "files": ["dist/bundle", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/bundle/types/index.d.ts",
      "import": "./dist/bundle/index.js"
    }
  },
  "devDependencies": {
    "@shortdrama-router/core": "0.2.0",
    "@shortdrama-router/http": "0.2.0",
    "@shortdrama-router/provider-jimeng": "0.2.0",
    "@shortdrama-router/provider-libtv": "0.2.0",
    "@shortdrama-router/provider-xiaoyunque": "0.2.0"
  },
  "scripts": {
    "build": "tsc -b --pretty false && node scripts/bundle-runtime.mjs && node scripts/bundle-types.mjs",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
