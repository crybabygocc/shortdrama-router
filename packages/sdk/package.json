{
  "name": "shortdrama-router",
  "version": "0.5.0",
  "description": "OpenAI/OpenRouter-style audio, image and video router for short-drama services",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "bin": {
    "shortdrama-router": "dist/bundle/cli.js"
  },
  "files": ["dist/bundle", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/bundle/types/index.d.ts",
      "import": "./dist/bundle/index.js"
    }
  },
  "devDependencies": {
    "@shortdrama-router/core": "0.5.0",
    "@shortdrama-router/http": "0.5.0",
    "@shortdrama-router/provider-jimeng": "0.5.0",
    "@shortdrama-router/provider-libtv": "0.5.0",
    "@shortdrama-router/provider-xiaoyunque": "0.5.0",
    "@shortdrama-router/runtime": "0.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crybabygocc/shortdrama-router.git"
  },
  "bugs": {
    "url": "https://github.com/crybabygocc/shortdrama-router/issues"
  },
  "homepage": "https://github.com/crybabygocc/shortdrama-router#readme",
  "scripts": {
    "build": "tsc -b --pretty false && node scripts/bundle-runtime.mjs && node scripts/bundle-types.mjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
